<?php

use Drupal\block\Entity\Block;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;

function carshowroom_ui_install() {
  $bundle = 'superhighlight_slide';
  if (!NodeType::load($bundle)) {
    NodeType::create([
      'type' => $bundle,
      'name' => 'Super Highlight slide',
      'description' => 'A slide for the home page Super Highlight carousel.',
      'display_submitted' => FALSE,
    ])->save();
  }

  $fields = [
    'field_slide_subtitle' => ['string', 'Subtitle', []],
    'field_slide_button_text' => ['string', 'Button text', []],
    'field_slide_link' => ['link', 'Button link', ['title' => 0]],
    'field_slide_image' => ['image', 'Background image', ['file_extensions' => 'png jpg jpeg webp', 'file_directory' => 'superhighlight', 'alt_field_required' => FALSE]],
    'field_slide_weight' => ['integer', 'Order (lowest number first)', []],
  ];
  foreach ($fields as $name => [$type, $label, $settings]) {
    if (!FieldStorageConfig::loadByName('node', $name)) {
      FieldStorageConfig::create(['field_name' => $name, 'entity_type' => 'node', 'type' => $type, 'cardinality' => 1])->save();
    }
    if (!FieldConfig::loadByName('node', $bundle, $name)) {
      FieldConfig::create([
        'field_name' => $name,
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => $label,
        'required' => FALSE,
        'settings' => $settings,
      ])->save();
    }
  }

  $form = EntityFormDisplay::load("node.$bundle.default")
    ?: EntityFormDisplay::create(['targetEntityType' => 'node', 'bundle' => $bundle, 'mode' => 'default', 'status' => TRUE]);
  $form->setComponent('title', ['type' => 'string_textfield', 'weight' => -5])
    ->setComponent('field_slide_subtitle', ['type' => 'string_textfield', 'weight' => 1])
    ->setComponent('field_slide_button_text', ['type' => 'string_textfield', 'weight' => 2])
    ->setComponent('field_slide_link', ['type' => 'link_default', 'weight' => 3])
    ->setComponent('field_slide_image', ['type' => 'image_image', 'weight' => 4])
    ->setComponent('field_slide_weight', ['type' => 'number', 'weight' => 5])
    ->setComponent('status', ['type' => 'boolean_checkbox', 'settings' => ['display_label' => TRUE], 'weight' => 100])
    ->save();

  $samples = [
    ['Welcome to Car Showroom', 'Discover your next car', 'Explore SUVs', 'internal:/vehicles/suv'],
    ['Performance Redefined', 'Sport cars', 'View Sportcars', 'internal:/vehicles/sportcars'],
    ['Comfort for Every Journey', 'Sedans', 'Browse Sedans', 'internal:/vehicles/sedan'],
    ['Expert Services', 'After-sales care', 'Our Services', 'internal:/services'],
  ];
  foreach ($samples as $i => [$title, $sub, $btn, $uri]) {
    Node::create([
      'type' => $bundle,
      'title' => $title,
      'status' => 1,
      'uid' => 1,
      'field_slide_subtitle' => $sub,
      'field_slide_button_text' => $btn,
      'field_slide_link' => ['uri' => $uri, 'title' => ''],
      'field_slide_weight' => $i + 1,
    ])->save();
  }

  if (!Block::load('olivero_superhighlight')) {
    Block::create([
      'id' => 'olivero_superhighlight',
      'theme' => 'olivero',
      'region' => 'hero',
      'weight' => -10,
      'plugin' => 'carshowroom_superhighlight',
      'settings' => ['id' => 'carshowroom_superhighlight', 'label' => 'Super Highlight', 'label_display' => '0', 'provider' => 'carshowroom_ui', 'interval' => 6, 'max_slides' => 8],
      'visibility' => ['request_path' => ['id' => 'request_path', 'negate' => FALSE, 'pages' => '<front>']],
    ])->save();
  }
  if (!Block::load('olivero_carshowroom_footer')) {
    Block::create([
      'id' => 'olivero_carshowroom_footer',
      'theme' => 'olivero',
      'region' => 'footer_top',
      'weight' => 0,
      'plugin' => 'carshowroom_footer',
      'settings' => ['id' => 'carshowroom_footer', 'label' => 'Car Showroom footer', 'label_display' => '0', 'provider' => 'carshowroom_ui'],
    ])->save();
  }

  \Drupal::configFactory()->getEditable('user.settings')
    ->set('register', 'visitors')
    ->set('verify_mail', FALSE)
    ->save();
}

/**
 * Re-point Super Highlight slide images to the git-tracked files under
 * public://superhighlight/, so they survive Render's ephemeral disk instead
 * of relying on images uploaded at runtime through the admin UI.
 */
function carshowroom_ui_update_10001() {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $file_storage = \Drupal::entityTypeManager()->getStorage('file');

  $map = [
    'Welcome to Car Showroom' => 'public://superhighlight/suv_superhighlight_0.webp',
    'Performance Redefined' => 'public://superhighlight/sport_car_superhighlight.webp',
    'Comfort for Every Journey' => 'public://superhighlight/sedan_superhighlight (1).jpg',
    'Expert Services' => 'public://superhighlight/expert_superhighlight.png',
  ];

  $updated = [];
  $skipped = [];

  foreach ($map as $title => $uri) {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'superhighlight_slide')
      ->condition('title', $title)
      ->execute();
    if (!$ids) {
      $skipped[] = "$title (node not found)";
      continue;
    }

    $real_path = \Drupal::service('file_system')->realpath($uri);
    if (!$real_path || !file_exists($real_path)) {
      $skipped[] = "$title ($uri not found on disk)";
      continue;
    }

    $existing_files = $file_storage->loadByProperties(['uri' => $uri]);
    if ($existing_files) {
      $file = reset($existing_files);
    }
    else {
      $file = \Drupal\file\Entity\File::create([
        'uri' => $uri,
        'uid' => 1,
        'status' => 1,
      ]);
      $file->save();
    }

    foreach ($storage->loadMultiple($ids) as $node) {
      $node->set('field_slide_image', [
        'target_id' => $file->id(),
        'alt' => $title . ' - Car Showroom Mauritius',
      ]);
      $node->save();
      $updated[] = $title;
    }
  }

  $msg = count($updated) . ' Super Highlight slide image(s) updated.';
  if ($skipped) {
    $msg .= ' Skipped: ' . implode(', ', $skipped);
  }
  return $msg;
}

/**
 * Remove the leftover "cars by category" Views block instances.
 *
 * Each category page (and the front page) already shows its car grid via
 * hardcoded, styled markup in the page body. An extra, unstyled copy of the
 * same cars was also being rendered by Views block instances placed in the
 * content_below region (olivero_views_block__cars_by_category_block_1..6),
 * producing a duplicate "Available X Models" section with plain, unstyled
 * thumbnails underneath the real grid. Deleting these block instances
 * removes the duplicate without touching the real content.
 */
function carshowroom_ui_update_10002() {
  $ids = [
    'olivero_views_block__cars_by_category_block_1',
    'olivero_views_block__cars_by_category_block_2',
    'olivero_views_block__cars_by_category_block_3',
    'olivero_views_block__cars_by_category_block_4',
    'olivero_views_block__cars_by_category_block_5',
    'olivero_views_block__cars_by_category_block_6',
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $deleted = [];
  $missing = [];

  foreach ($ids as $id) {
    $block = $storage->load($id);
    if ($block) {
      $block->delete();
      $deleted[] = $id;
    }
    else {
      $missing[] = $id;
    }
  }

  $msg = count($deleted) . ' duplicate "cars by category" block(s) removed.';
  if ($missing) {
    $msg .= ' Not found (already removed?): ' . implode(', ', $missing);
  }
  return $msg;
}

/**
 * Correct update_10002: restore the real-photo car grid, remove the fake one.
 *
 * Update #10002 deleted the wrong side of the duplicate. The Views blocks
 * (cars_by_category-block_1/2/3) render the actual "car" nodes with their
 * real uploaded field_image photos — that is the content that should stay.
 * The markup still sitting in each category page's body is a hand-built,
 * text-only placeholder grid (blue gradient header, no real photo, just a
 * "SUV"/"Sportcars"/"Sedan" label) — that is the one to remove.
 *
 * This re-creates the three category-page Views blocks (not the three
 * homepage ones — the front page never had a matching placeholder grid to
 * begin with, so those were pure leftover clutter and stay removed), then
 * strips the placeholder grid markup out of each category page's body,
 * leaving the intro paragraph and the "Interested in a X?" call to action.
 */
function carshowroom_ui_update_10003() {
  $block_defs = [
    'olivero_views_block__cars_by_category_block_1' => [
      'uuid' => '1c07af09-620e-4121-9cc3-b0b9d06487ea',
      'plugin' => 'views_block:cars_by_category-block_1',
      'path' => '/vehicles/suv',
    ],
    'olivero_views_block__cars_by_category_block_2' => [
      'uuid' => 'befa21ea-7a71-49ae-9696-611d51ed0bd1',
      'plugin' => 'views_block:cars_by_category-block_2',
      'path' => '/vehicles/sportcars',
    ],
    'olivero_views_block__cars_by_category_block_3' => [
      'uuid' => '67520241-5d90-4704-bbcd-96203f7fbd7b',
      'plugin' => 'views_block:cars_by_category-block_3',
      'path' => '/vehicles/sedan',
    ],
  ];

  $restored = [];
  foreach ($block_defs as $id => $def) {
    if (Block::load($id)) {
      continue;
    }
    Block::create([
      'id' => $id,
      'theme' => 'olivero',
      'region' => 'content_below',
      'weight' => 0,
      'plugin' => $def['plugin'],
      'settings' => [
        'id' => $def['plugin'],
        'label' => '',
        'label_display' => 'visible',
        'provider' => 'views',
        'views_label' => '',
        'items_per_page' => NULL,
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => $def['path'],
        ],
      ],
    ])->save();
    $restored[] = $id;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $labels = ['suv' => 'SUV', 'sportcars' => 'Sportcars', 'sedan' => 'Sedan'];
  $stripped = [];

  foreach ($labels as $key => $label) {
    $path = \Drupal::service('path_alias.manager')->getPathByAlias('/vehicles/' . $key);
    if (!preg_match('#/node/(\d+)#', $path, $m)) {
      continue;
    }
    $node = $storage->load($m[1]);
    if (empty($node)) {
      continue;
    }
    $body = $node->get('body')->value;
    $heading = '<h2>Available ' . $label . ' models</h2>';
    $pattern = '#' . preg_quote($heading, '#') . '.*?(?=<h2>Interested in)#s';
    $updated = preg_replace($pattern, '', $body, 1, $count);
    if ($count) {
      $node->set('body', ['value' => $updated, 'format' => 'full_html']);
      $node->save();
      $stripped[] = $label;
    }
  }

  return count($restored) . ' block(s) restored (' . implode(', ', $restored) . '); '
    . count($stripped) . ' page body/bodies cleaned of the placeholder grid (' . implode(', ', $stripped) . ').';
}

/**
 * Restore the three homepage "latest arrivals" carousel blocks.
 *
 * Update #10002 also deleted olivero_views_block__cars_by_category_block_4,
 * _5 and _6. Those are NOT duplicates of anything — they are the three
 * distinct "SUV carousel" / "Sportcars carousel" / "Sedan carousel" block
 * displays of the cars_by_category view (titled "Latest SUV Arrivals",
 * "Latest Sport Cars", "Latest Sedan Arrivals"), each showing a different
 * category on the front page. Removing them took three legitimate homepage
 * sections off the site. This recreates all three.
 */
function carshowroom_ui_update_10004() {
  $block_defs = [
    'olivero_views_block__cars_by_category_block_4' => 'views_block:cars_by_category-block_4',
    'olivero_views_block__cars_by_category_block_5' => 'views_block:cars_by_category-block_5',
    'olivero_views_block__cars_by_category_block_6' => 'views_block:cars_by_category-block_6',
  ];

  $restored = [];
  foreach ($block_defs as $id => $plugin) {
    if (Block::load($id)) {
      continue;
    }
    Block::create([
      'id' => $id,
      'theme' => 'olivero',
      'region' => 'content_below',
      'weight' => 0,
      'plugin' => $plugin,
      'settings' => [
        'id' => $plugin,
        'label' => '',
        'label_display' => 'visible',
        'provider' => 'views',
        'views_label' => '',
        'items_per_page' => NULL,
      ],
      'visibility' => [
        'request_path' => [
          'id' => 'request_path',
          'negate' => FALSE,
          'pages' => '<front>',
        ],
      ],
    ])->save();
    $restored[] = $id;
  }

  return count($restored) . ' homepage carousel block(s) restored (' . implode(', ', $restored) . ').';
}

/**
 * Create the carshowroom_dbfiles backup table and back up readable files.
 *
 * Render's free tier gives the web service no persistent disk: every
 * redeploy throws away the old container's filesystem and starts a fresh
 * one from the Docker image, which only contains whatever was committed to
 * Git. Images uploaded live through the site (new car photos, etc.) were
 * only ever written to that disposable disk, so they disappeared the next
 * time the site was redeployed.
 *
 * From this update onward, every uploaded public file's bytes are also
 * copied into this table (hook_file_insert()/hook_file_update() in
 * carshowroom_ui.module), and DbFileRestoreSubscriber writes them back out
 * to disk the first time each new container boots. The table itself lives
 * in the external MySQL database on Clever Cloud, which is not wiped by a
 * Render redeploy, so from here on an uploaded image survives indefinitely.
 *
 * This update also does a best-effort backfill of whatever public files
 * are still readable on disk right now. A file that only ever existed on a
 * container that has already been replaced by an earlier deploy can no
 * longer be read from here; it is skipped, and a fresh upload of it (after
 * this update is live) will be backed up automatically going forward.
 */
function carshowroom_ui_update_10005() {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('carshowroom_dbfiles')) {
    $schema->createTable('carshowroom_dbfiles', [
      'description' => 'Backup copy of public file bytes, kept in the persistent database so uploaded images survive container redeploys on hosts (like Render) that have no persistent disk.',
      'fields' => [
        'uri' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'description' => 'The public:// URI of the file this row backs up.',
        ],
        'filemime' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => FALSE,
        ],
        'filesize' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'data' => [
          'type' => 'blob',
          'size' => 'big',
          'not null' => TRUE,
          'description' => 'Raw file bytes.',
        ],
        'changed' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Unix timestamp of the last backup.',
        ],
      ],
      'primary key' => ['uri'],
    ]);
  }

  $file_system = \Drupal::service('file_system');
  $storage = \Drupal::entityTypeManager()->getStorage('file');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();

  $backed_up = 0;
  $missing = 0;
  foreach ($storage->loadMultiple($ids) as $file) {
    $uri = $file->getFileUri();
    if (strpos($uri, 'public://') !== 0) {
      continue;
    }
    $real_path = $file_system->realpath($uri);
    if (!$real_path || !is_file($real_path)) {
      $missing++;
      continue;
    }
    $data = file_get_contents($real_path);
    if ($data === FALSE) {
      $missing++;
      continue;
    }
    \Drupal::database()->merge('carshowroom_dbfiles')
      ->key('uri', $uri)
      ->fields([
        'filemime' => $file->getMimeType(),
        'filesize' => strlen($data),
        'data' => $data,
        'changed' => \Drupal::time()->getRequestTime(),
      ])
      ->execute();
    $backed_up++;
  }

  $msg = "carshowroom_dbfiles table created. $backed_up file(s) backed up to the database.";
  if ($missing) {
    $msg .= " $missing file record(s) had no readable file on this container and were skipped - re-upload those (if any are still missing from the site) after this update is live, and they will be backed up automatically from then on.";
  }
  return $msg;
}
